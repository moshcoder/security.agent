{
  "name": "@profullstack/securityagent",
  "version": "0.1.1",
  "description": "security.agent: a security team for your AI agent. Sign in with ThreatCrush (OAuth 2.1) and check IPs, domains and files, read findings and incidents, from the web, API, CLI, TUI or MCP.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://security.agent.pit.world",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moshcoder/security.agent.git"
  },
  "keywords": ["security", "threatcrush", "mcp", "ai-agent", "oauth", "reputation", "antivirus", "cli"],
  "bin": {
    "securityagent": "bin/securityagent"
  },
  "files": ["bin/securityagent", "src", "public", "README.md", "LICENSE"],
  "engines": {
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@profullstack/ai-providers": "^0.3.2",
